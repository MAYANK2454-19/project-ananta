# Create a Supabase project, then copy these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Exact email allowed into the admin panel. No public/default admin password.
ADMIN_EMAIL=admin@example.com
# Registration form URL (Google Form or your future custom registration route)
NEXT_PUBLIC_REGISTRATION_URL=https://forms.gle/REPLACE_WITH_REAL_FORM
