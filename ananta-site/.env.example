# Public Supabase configuration (these values are sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only privileged key for the Google Forms CSV import API.
# Never prefix this variable with NEXT_PUBLIC_ and never use it in client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: overrides the organiser-approved Google registration form.
# NEXT_PUBLIC_REGISTRATION_URL=https://example.com/register
